<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚛ Equation Solver"
            android:textSize="18sp"
            android:textColor="@color/neon_cyan"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp"/>

        <!-- Type Selector -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="EQUATION TYPE" style="@style/SectionTitle" android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnLinear"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/btn_mode_bg"
                android:padding="4dp"
                android:text="📏 Linear\nax+b=0"
                android:textColor="@color/btn_arith_stroke"
                android:textSize="11sp"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btnQuadratic"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/btn_mode_bg"
                android:padding="4dp"
                android:text="📈 Quadratic\nax²+bx+c=0"
                android:textColor="@color/btn_arith_stroke"
                android:textSize="11sp"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btnCubic"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/btn_mode_bg"
                android:padding="4dp"
                android:text="🌀 Cubic\nax³+bx²+…=0"
                android:textColor="@color/btn_arith_stroke"
                android:textSize="11sp"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>

        <!-- Equation display -->
        <TextView
            android:id="@+id/tvEquationHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ax + b = 0"
            android:textSize="20sp"
            android:textColor="@color/btn_arith_stroke"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Enter Coefficients label -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ENTER COEFFICIENTS" style="@style/SectionTitle" android:layout_marginBottom="8dp"/>

        <!-- Coefficients -->
        <LinearLayout
            android:id="@+id/coeffContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"/>

        <!-- Solve Button -->
        <Button
            android:id="@+id/btnSolve"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="🔍  SOLVE EQUATION"
            android:textSize="15sp"
            android:textColor="#F44336"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/btn_action_bg"
            android:letterSpacing="0.08"
            android:layout_marginBottom="16dp"/>

        <!-- Steps & Result -->
        <LinearLayout
            android:id="@+id/solutionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/result_bg"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOLUTION"
                style="@style/SectionTitle"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvSolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="18sp"
                android:textColor="@color/neon_green"
                android:fontFamily="monospace"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/glass_cyan" android:layout_marginVertical="10dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="STEPS" style="@style/SectionTitle" android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
