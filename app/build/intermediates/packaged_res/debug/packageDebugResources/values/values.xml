    <style name="CalcButton" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">4dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="CalcButtonClear" parent="CalcButton">
        <item name="android:background">@drawable/btn_clear_bg</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="CalcButtonConst" parent="CalcButton">
        <item name="android:background">@drawable/btn_const_bg</item>
        <item name="android:textColor">@color/btn_const_text</item>
