<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ScientificCalculator" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorPrimaryVariant">@color/neon_blue</item>
        <item name="colorOnPrimary">@color/bg_primary</item>
        <item name="colorSecondary">@color/neon_purple</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSurface">@color/bg_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="tabStyle">@style/FuturisticTabStyle</item>
    </style>

    <style name="FuturisticTabStyle" parent="Widget.Material3.TabLayout">
        <item name="tabSelectedTextColor">@color/neon_cyan</item>
        <item name="tabTextColor">@color/text_dim</item>
        <item name="tabIndicatorColor">@color/neon_cyan</item>
        <item name="tabBackground">@color/transparent</item>
        <item name="tabTextAppearance">@style/TabTextAppearance</item>
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="textAllCaps">true</item>
    </style>

    <style name="CalcButton" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">4dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CalcButtonNumber" parent="CalcButton">
        <item name="android:background">@drawable/btn_number_bg</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CalcButtonOperator" parent="CalcButton">
        <item name="android:background">@drawable/btn_operator_bg</item>
        <item name="android:textColor">@color/btn_arith_text</item>
    </style>

    <style name="CalcButtonFunction" parent="CalcButton">
        <item name="android:background">@drawable/btn_function_bg</item>
        <item name="android:textColor">@color/neon_purple</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CalcButtonTrig" parent="CalcButton">
        <item name="android:background">@drawable/btn_trig_bg</item>
        <item name="android:textColor">@color/btn_trig_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CalcButtonLog" parent="CalcButton">
        <item name="android:background">@drawable/btn_log_bg</item>
        <item name="android:textColor">@color/btn_log_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CalcButtonPower" parent="CalcButton">
        <item name="android:background">@drawable/btn_power_bg</item>
        <item name="android:textColor">@color/btn_power_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CalcButtonConst" parent="CalcButton">
        <item name="android:background">@drawable/btn_const_bg</item>
        <item name="android:textColor">@color/btn_const_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CalcButtonParen" parent="CalcButton">
        <item name="android:background">@drawable/btn_paren_bg</item>
        <item name="android:textColor">@color/btn_paren_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CalcButtonDel" parent="CalcButton">
        <item name="android:background">@drawable/btn_del_bg</item>
        <item name="android:textColor">@color/btn_del_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CalcButtonSign" parent="CalcButton">
        <item name="android:background">@drawable/btn_sign_bg</item>
        <item name="android:textColor">@color/btn_sign_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CalcButtonEqual" parent="CalcButton">
        <item name="android:background">@drawable/btn_equal_bg</item>
        <item name="android:textColor">#050A18</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="CalcButtonClear" parent="CalcButton">
        <item name="android:background">@drawable/btn_clear_bg</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalcButtonSpecial" parent="CalcButton">
        <item name="android:background">@drawable/btn_special_bg</item>
        <item name="android:textColor">@color/neon_yellow</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/neon_cyan</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="textAllCaps">true</item>
    </style>

    <style name="InputStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/neon_cyan</item>
        <item name="hintTextColor">@color/neon_cyan</item>
        <item name="android:textColorHint">@color/text_dim</item>
    </style>

</resources>
