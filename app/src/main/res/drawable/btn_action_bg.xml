<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1A3A5C"
                android:endColor="#0D2040"
                android:angle="135"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1.8dp" android:color="#00F5FF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0D1F3C"
                android:endColor="#060E22"
                android:angle="135"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1.2dp" android:color="#1A4A7A"/>
        </shape>
    </item>
</selector>
